  "cards": [
    {"dot": "cyan", "title": "两种进度", "items": ["cursor 是 HTTP 已验证拉取位置，只在运行器内存维护。", "receipt 是服务端本人已读进度及版本；获取消息不自动确认已读。", "时序纵向表示逻辑顺序，不表示实测耗时；启动两条任务并行。"]},
    {"dot": "emerald", "title": "断线也能补查", "items": ["READY、实时帧、重新上线和页面可见性变化均可触发同步。", "HTTP 前台约 15 秒、隐藏约 60 秒补查；逐页验证连续序号。", "每次重连重新取票，指数退避；旧会话退出即销毁连接与请求。"]},
    {"dot": "rose", "title": "并发与结果未知", "items": ["本地页面过期直接拒绝 PUT；用户显式重读后重新确认。", "服务端 409 或 PUT 结果未知先同步权威状态，页面锁定重复确认。", "后台新消息不会偷偷扩大当前页面的已读确认范围。"]}
  ]
