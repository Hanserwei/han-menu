{
  "name": "han-menu-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "pnpm format:check && pnpm api:check && pnpm lint && pnpm check:boundaries && pnpm type-check && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "pinia": "4.0.3",
    "@tanstack/vue-query": "5.103.1",
    "antdv-next": "1.5.4",
    "@antdv-next/icons": "1.1.2",
    "openapi-fetch": "0.17.0",
    "dayjs": "1.11.23"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "0.9.1",
    "@vue/test-utils": "2.5.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "typescript-eslint": "8.70.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11",
    "jsdom": "30.1.0",
    "openapi-typescript": "7.13.0",
    "@playwright/test": "1.63.0",
    "pg": "8.23.0",
    "@tsconfig/node24": "24.0.5",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "vue-eslint-parser": "10.4.1"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.4.2 <13"
  },
  "packageManager": "pnpm@12.4.2"
}
