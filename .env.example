# 执行 python3 scripts/middleware.py up 可生成全部本机配置与随机凭证。
# 也可复制为 .env 并手工设置；注释掉的密码项会在首次启动时自动生成。
POSTGRES_BIND_ADDRESS=127.0.0.1
IDENTITY_BOOTSTRAP_USERNAME=admin
IDENTITY_BOOTSTRAP_ENABLED=true
# IDENTITY_BOOTSTRAP_PASSWORD=首次初始化管理员的密码，省略时由部署脚本随机生成
# POSTGRES_PASSWORD=数据库管理员密码
DB_URL=jdbc:postgresql://localhost:5432/han_menu
DB_USERNAME=han_menu
# DB_PASSWORD=项目受限角色密码
TEST_DB_URL=jdbc:postgresql://localhost:5432/han_menu_test
TEST_DB_USERNAME=han_menu
# TEST_DB_PASSWORD=与 DB_PASSWORD 相同；省略时自动使用同一个密码

# 执行 python3 scripts/middleware.py up 可自动生成以下本机配置及随机凭证。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_DATABASE=0
REDIS_KEY_PREFIX=han-menu:
# REDIS_PASSWORD=手动设置或保持注释以自动生成
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_CONSOLE_URL=http://127.0.0.1:9001/rustfs/console/
RUSTFS_REGION=us-east-1
# RUSTFS_ACCESS_KEY=手动设置或保持注释以自动生成
# RUSTFS_SECRET_KEY=手动设置或保持注释以自动生成
RUSTFS_BUCKET=han-menu
RUSTFS_TEST_BUCKET=han-menu-test
