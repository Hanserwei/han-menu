#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Validate the exact staged tree; reject partial staging instead of hiding changes in a stash.
if ! git diff --quiet; then
  echo "Stage all code changes before committing so the verified tree matches the index." >&2
  exit 1
fi
if [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
  echo "Stage or ignore untracked files before committing." >&2
  exit 1
fi
exec ./scripts/verify.sh
